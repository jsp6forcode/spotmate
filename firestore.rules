rules_version = '2';
// SpotMate 부모 리뷰 (Firebase 콘솔 > Firestore Database > Rules 에 붙여 넣기)
// - 누구나 읽을 수 있어요
// - 구글로 로그인한 사람만, 장소마다 한 개씩(문서 id = 장소id_사용자uid) 쓰고 고칠 수 있어요
// - 별점 1~5 정수, 글 600자, 이름 40자까지. 다른 필드는 못 넣어요. 작성 시간은 서버 시간만
// - 지우기는 쓴 사람만 (운영자는 콘솔에서 지울 수 있어요)
// - feedback: 보내기만 되고 읽기는 콘솔에서만
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && id == request.resource.data.spotId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['spotId', 'uid', 'name', 'rating', 'text', 'createdAt'])
        && request.resource.data.spotId is string && request.resource.data.spotId.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 600
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // About 탭 피드백: 누구나 보낼 수 있지만(로그인 없이) 아무도 읽거나 고칠 수 없어요. 운영자는 콘솔에서 읽어요
    match /feedback/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['type', 'place', 'message', 'email', 'createdAt'])
        && request.resource.data.type in ['wrong', 'place', 'idea']
        && request.resource.data.place is string && request.resource.data.place.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1000
        && request.resource.data.email is string && request.resource.data.email.size() <= 100
        && request.resource.data.createdAt == request.time;
    }
    // 장소 제보 (2026-11-22): 누구나 보낼 수 있어요(로그인 없이). 읽기·지우기는 운영자 계정(uid)만. 고치기는 아무도 못 해요
    // 사진은 Storage 대신 줄인 JPEG data URL(70만 자 이하)로 문서 안에 들어와요. 사진이 있으면 photoOk(직접 찍음·아이 얼굴 없음·사용 허락)가 true 여야 해요
    match /suggestions/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == '94qUVledUwZccG5aMzxUAf7GyM03';
      allow update: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'area', 'link', 'why', 'email', 'photo', 'photoOk', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.area is string && request.resource.data.area.size() <= 80
        && request.resource.data.link is string && request.resource.data.link.size() <= 300
        && request.resource.data.why is string && request.resource.data.why.size() > 0 && request.resource.data.why.size() <= 1000
        && request.resource.data.email is string && request.resource.data.email.size() <= 100
        && request.resource.data.photoOk is bool
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 700000
        && (request.resource.data.photo == '' || (request.resource.data.photoOk == true && request.resource.data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
    }
  }
}
